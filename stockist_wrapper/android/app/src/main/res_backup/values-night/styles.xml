<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Do not use Theme.Black here: it flashes a black window after the
         system splash and, on API 31+, night resources beat values-v31 so
         the Flutter launcher icon would come back. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/dashen_green</item>
        <item name="android:navigationBarColor">@color/dashen_green</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/dashen_green</item>
        <item name="android:statusBarColor">@color/dashen_green</item>
        <item name="android:navigationBarColor">@color/dashen_green</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
