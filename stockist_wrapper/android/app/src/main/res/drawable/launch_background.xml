<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by Android 11 and older while the app starts (Android 12+ uses the
     system splash screen configured in values-v31/styles.xml instead).
     The logo image already contains its own transparent padding, so a 240dp
     box gives a ~160dp white circle on the Dashen green background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dashen_green" />
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>