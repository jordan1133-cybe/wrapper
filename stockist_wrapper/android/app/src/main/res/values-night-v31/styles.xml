<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night mode outranks the API-level folder, so dark-mode Android 12+
         needs its own copy of the same splash configuration. -->
    <!-- Android 12+ system splash screen: Dashen green with the logo centred.
         The logo drawable keeps its content inside the central 2/3 (the area
         the system keeps), so nothing is clipped. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/dashen_green</item>
        <item name="android:windowSplashScreenBackground">@color/dashen_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:statusBarColor">@color/dashen_green</item>
        <item name="android:navigationBarColor">@color/dashen_green</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/dashen_green</item>
        <item name="android:statusBarColor">@color/dashen_green</item>
        <item name="android:navigationBarColor">@color/dashen_green</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>